{
  "schemaVersion": "0.1",
  "id": "story_template",
  "version": 1,
  "title": "Il fornaio scomparso",
  "author": "Team PokeRPG",
  "description": "Una piccola storia giocabile che usa ogni campo dello Story Schema e ogni comando di scena. Copiala e modificala.",
  "language": "it",
  "start": { "location": "harbour", "spawn": "spawn_start", "facing": "down" },
  "locations": [
    {
      "id": "harbour",
      "asset": "loc_greybox-harbour",
      "links": { "exit_house_door": { "location": "bakery", "spawn": "spawn_door_inside" } }
    },
    {
      "id": "bakery",
      "asset": "loc_greybox-bakery",
      "links": { "exit_house_door": { "location": "harbour", "spawn": "spawn_from_house" } }
    }
  ],
  "npcs": [
    {
      "id": "rosa",
      "name": "Rosa",
      "character": "chr_rosa",
      "placements": [
        {
          "when": { "quest": "find-baker", "is": "complete" },
          "location": "harbour",
          "tile": [9, 5],
          "facing": "down",
          "behaviour": { "type": "static" }
        },
        {
          "location": "bakery",
          "tile": [5, 3],
          "facing": "left",
          "behaviour": { "type": "wander", "radius": 1 }
        }
      ],
      "dialogues": [
        {
          "when": { "all": [{ "flag": "met-rosa" }, { "quest": "find-baker", "is": "complete" }] },
          "lines": ["Grazie ancora, {player.name}!"]
        },
        {
          "when": { "quest": "find-baker", "is": "active" },
          "lines": ["Oh, c'è qualcuno. Un momento."]
        },
        { "when": { "flag": "met-rosa" }, "lines": ["Di nuovo qui, {player.name}?"] },
        { "lines": ["Che piacere vederti nel mio forno!", "Pane fresco ogni mattina."] }
      ]
    },
    {
      "id": "tomas",
      "name": "Tomas",
      "character": "chr_tomas",
      "placements": [
        {
          "when": {
            "any": [
              { "task": "deliver-note.reach-dock", "is": "active" },
              { "task": "deliver-note.talk-tomas", "is": "active" }
            ]
          },
          "location": "harbour",
          "tile": [17, 7],
          "facing": "down",
          "behaviour": {
            "type": "patrol",
            "path": [
              [17, 7],
              [17, 9]
            ]
          }
        },
        {
          "location": "harbour",
          "tile": [13, 6],
          "facing": "down",
          "behaviour": { "type": "look-around" }
        }
      ],
      "dialogues": [
        {
          "when": { "task": "deliver-note.talk-tomas", "is": "complete" },
          "lines": ["Buon vento, {player.name}."]
        },
        {
          "when": { "quest": "deliver-note", "is": "notStarted" },
          "lines": ["Giornata intensa al porto."]
        },
        {
          "when": { "not": { "flag": "met-tomas" } },
          "lines": [
            "Ehilà! Non capiti spesso da queste parti.",
            { "speaker": "player", "text": "Sono {player.name}. Sto cercando il fornaio." }
          ]
        },
        { "lines": ["La marea sta salendo."] }
      ]
    }
  ],
  "flags": ["met-rosa", "met-tomas", "saw-boat", "delivered"],
  "quests": [
    {
      "id": "find-baker",
      "title": "Il fornaio scomparso",
      "tasks": [
        {
          "id": "intro",
          "type": "scene",
          "scene": "harbour-intro",
          "objective": "Guarda intorno al porto"
        },
        {
          "id": "reach-plaza",
          "type": "reach",
          "location": "harbour",
          "area": "area_plaza",
          "objective": "Vai alla piazza"
        },
        {
          "id": "talk-rosa",
          "type": "talk",
          "npc": "rosa",
          "objective": "Trova il fornaio",
          "lines": [
            "Oh! Mi hai trovata.",
            { "speaker": "player", "text": "Tutti ti stanno cercando." },
            { "speaker": "narrator", "text": "Rosa sorride." }
          ],
          "onComplete": { "flags": { "met-rosa": true }, "scene": "rosa-returns" }
        }
      ]
    },
    {
      "id": "deliver-note",
      "title": "Un biglietto per Tomas",
      "tasks": [
        {
          "id": "reach-dock",
          "type": "reach",
          "location": "harbour",
          "spawn": "spawn_dock",
          "objective": "Vai al molo"
        },
        {
          "id": "talk-tomas",
          "type": "talk",
          "npc": "tomas",
          "objective": "Dai il biglietto a Tomas",
          "lines": [
            { "speaker": "narrator", "text": "Consegni il biglietto." },
            "Ah, il biglietto! Grazie, {player.name}."
          ],
          "onComplete": { "flags": { "delivered": true }, "scene": "tour" }
        }
      ]
    }
  ],
  "scenes": {
    "opening": [
      { "cmd": "fade", "to": "in", "ms": 800 },
      { "cmd": "music", "track": "mus_town_greybox" },
      {
        "cmd": "say",
        "lines": [{ "speaker": "narrator", "text": "Una tranquilla mattina al porto." }]
      }
    ],
    "harbour-intro": [
      { "cmd": "camera", "to": [10, 4], "ms": 600 },
      { "cmd": "wait", "ms": 500 },
      { "cmd": "camera", "to": "tomas" },
      { "cmd": "camera", "to": "player", "ms": 400 },
      { "cmd": "sound", "sfx": "sfx_greybox-step" },
      {
        "cmd": "say",
        "lines": [{ "speaker": "player", "text": "Dove sono tutti? Ciao, sono {player.name}." }]
      }
    ],
    "rosa-returns": [
      { "cmd": "fade", "to": "out" },
      { "cmd": "warp", "location": "harbour", "spawn": "spawn_from_house" },
      { "cmd": "show", "npc": "rosa", "location": "harbour", "tile": [9, 5], "facing": "down" },
      { "cmd": "fade", "to": "in" },
      {
        "cmd": "move",
        "actor": "rosa",
        "path": [
          [9, 5],
          [9, 7],
          [11, 7]
        ],
        "parallel": true
      },
      { "cmd": "face", "actor": "player", "toward": "rosa" },
      {
        "cmd": "say",
        "lines": [{ "speaker": "rosa", "text": "Sono tornata! Grazie, {player.name}." }]
      },
      { "cmd": "face", "actor": "rosa", "dir": "left" }
    ],
    "boat-leaves": [
      { "cmd": "sound", "sfx": "sfx_greybox-boat" },
      { "cmd": "music", "track": null },
      { "cmd": "hide", "npc": "tomas" },
      { "cmd": "wait", "ms": 1200 },
      { "cmd": "show", "npc": "tomas", "location": "harbour", "tile": [13, 6], "facing": "down" },
      { "cmd": "flag", "set": { "saw-boat": true } }
    ],
    "tomas-hello": [
      { "cmd": "face", "actor": "tomas", "toward": "player" },
      {
        "cmd": "say",
        "lines": [{ "speaker": "tomas", "text": "Piacere di conoscerti, {player.name}." }]
      },
      { "cmd": "flag", "set": { "met-tomas": true } }
    ],
    "tour": [
      { "cmd": "fade", "to": "out", "ms": 300 },
      { "cmd": "warp", "location": "bakery", "spawn": "spawn_counter", "facing": "up" },
      { "cmd": "fade", "to": "in" },
      { "cmd": "sound", "sfx": "sfx_greybox-door" },
      {
        "cmd": "say",
        "lines": [
          { "speaker": "narrator", "text": "Questo era l'intero modello. Ora rendilo tuo." }
        ]
      }
    ]
  },
  "triggers": [
    { "on": "storyStart", "scene": "opening" },
    {
      "on": "enterArea",
      "location": "harbour",
      "area": "area_docks",
      "once": true,
      "when": { "not": { "flag": "saw-boat" } },
      "scene": "boat-leaves"
    },
    { "on": "talk", "npc": "tomas", "when": { "flag": "met-rosa" }, "scene": "tomas-hello" }
  ]
}
