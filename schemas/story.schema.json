{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ciprognola.github.io/PokeRPG/schemas/story.schema.json",
  "title": "PokeRPG story.json",
  "description": "Story Schema (docs/STORY_SCHEMA.md). Structure only; references, tiles and text length are checked by the story validator.",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "id": {
      "type": "string",
      "pattern": "^story_[a-z0-9]+(-[a-z0-9]+)*$",
      "x-hint": "must look like story_<id> (lowercase letters, digits and \"-\")"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "author": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "type": "string",
      "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$",
      "x-hint": "must be a BCP 47 code such as \"en\" or \"it\""
    },
    "start": {
      "$ref": "#/$defs/start"
    },
    "locations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/location"
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/npc"
      }
    },
    "flags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/id"
      }
    },
    "quests": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/quest"
      }
    },
    "scenes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/scene"
      },
      "propertyNames": {
        "$ref": "#/$defs/id"
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/trigger"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "version",
    "title",
    "author",
    "description",
    "language",
    "start",
    "locations",
    "quests"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "x-hint": "must be lowercase letters, digits and \"-\""
    },
    "tile": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      },
      "minItems": 2,
      "maxItems": 2
    },
    "direction": {
      "enum": [
        "down",
        "left",
        "right",
        "up"
      ]
    },
    "libraryLocation": {
      "type": "string",
      "pattern": "^loc_[a-z0-9-]+(_[a-z0-9-]+)*$",
      "x-hint": "must look like loc_<name>"
    },
    "anchor": {
      "type": "string",
      "pattern": "^[a-z0-9]+([_-][a-z0-9]+)*$",
      "x-hint": "must be lowercase letters, digits, \"-\" and \"_\""
    },
    "character": {
      "type": "string",
      "pattern": "^chr_[a-z0-9-]+$",
      "x-hint": "must look like chr_<name>"
    },
    "track": {
      "type": "string",
      "pattern": "^mus_[a-z0-9-]+(_[a-z0-9-]+)*$",
      "x-hint": "must look like mus_<use>_<name>"
    },
    "sfx": {
      "type": "string",
      "pattern": "^sfx_[a-z0-9-]+$",
      "x-hint": "must look like sfx_<name>"
    },
    "taskRef": {
      "type": "string",
      "pattern": "^[a-z0-9-]+\\.[a-z0-9-]+$",
      "x-hint": "must look like <questId>.<taskId>"
    },
    "flagMap": {
      "type": "object",
      "additionalProperties": {
        "type": "boolean"
      },
      "propertyNames": {
        "$ref": "#/$defs/id"
      }
    },
    "start": {
      "type": "object",
      "properties": {
        "location": {
          "$ref": "#/$defs/id"
        },
        "spawn": {
          "$ref": "#/$defs/anchor"
        },
        "facing": {
          "$ref": "#/$defs/direction"
        }
      },
      "required": [
        "location",
        "spawn",
        "facing"
      ],
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "asset": {
          "$ref": "#/$defs/libraryLocation"
        },
        "links": {
          "type": "object",
          "propertyNames": {
            "$ref": "#/$defs/anchor"
          },
          "additionalProperties": {
            "type": "object",
            "properties": {
              "location": {
                "$ref": "#/$defs/id"
              },
              "spawn": {
                "$ref": "#/$defs/anchor"
              }
            },
            "required": [
              "location",
              "spawn"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "asset"
      ],
      "additionalProperties": false
    },
    "npc": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "character": {
          "$ref": "#/$defs/character"
        },
        "placements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/placement"
          }
        },
        "dialogues": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dialogue"
          }
        }
      },
      "required": [
        "id",
        "name",
        "character"
      ],
      "additionalProperties": false
    },
    "placement": {
      "type": "object",
      "properties": {
        "when": {
          "$ref": "#/$defs/condition"
        },
        "location": {
          "$ref": "#/$defs/id"
        },
        "tile": {
          "$ref": "#/$defs/tile"
        },
        "facing": {
          "$ref": "#/$defs/direction"
        },
        "behaviour": {
          "$ref": "#/$defs/behaviour"
        }
      },
      "required": [
        "location",
        "tile",
        "facing"
      ],
      "additionalProperties": false
    },
    "behaviour": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "static",
            "look-around",
            "wander",
            "patrol"
          ]
        }
      },
      "required": [
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "static"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "type"
            ],
            "propertyNames": {
              "enum": [
                "type"
              ]
            },
            "properties": {}
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "look-around"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "type"
            ],
            "propertyNames": {
              "enum": [
                "type"
              ]
            },
            "properties": {}
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "wander"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "type",
              "radius"
            ],
            "propertyNames": {
              "enum": [
                "type",
                "radius"
              ]
            },
            "properties": {
              "radius": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "patrol"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "type",
              "path"
            ],
            "propertyNames": {
              "enum": [
                "type",
                "path"
              ]
            },
            "properties": {
              "path": {
                "type": "array",
                "minItems": 2,
                "items": {
                  "$ref": "#/$defs/tile"
                }
              }
            }
          }
        }
      ]
    },
    "dialogue": {
      "type": "object",
      "properties": {
        "when": {
          "$ref": "#/$defs/condition"
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/line"
          }
        }
      },
      "required": [
        "lines"
      ],
      "additionalProperties": false
    },
    "line": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "properties": {
            "speaker": {
              "type": "string",
              "minLength": 1
            },
            "text": {
              "type": "string"
            }
          },
          "required": [
            "speaker",
            "text"
          ],
          "additionalProperties": false
        }
      ],
      "x-hint": "must be a string or { \"speaker\", \"text\" }"
    },
    "quest": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "tasks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/task"
          }
        }
      },
      "required": [
        "id",
        "title"
      ],
      "additionalProperties": false
    },
    "task": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "type": {
          "enum": [
            "scene",
            "reach",
            "talk"
          ]
        },
        "objective": {
          "type": "string",
          "minLength": 1
        },
        "onComplete": {
          "$ref": "#/$defs/onComplete"
        }
      },
      "required": [
        "id",
        "type",
        "objective"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "scene"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "id",
              "type",
              "objective",
              "scene"
            ],
            "propertyNames": {
              "enum": [
                "id",
                "type",
                "objective",
                "onComplete",
                "scene"
              ]
            },
            "properties": {
              "scene": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "reach"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "id",
              "type",
              "objective",
              "location"
            ],
            "propertyNames": {
              "enum": [
                "id",
                "type",
                "objective",
                "onComplete",
                "location",
                "area",
                "spawn"
              ]
            },
            "properties": {
              "location": {
                "$ref": "#/$defs/id"
              },
              "area": {
                "$ref": "#/$defs/anchor"
              },
              "spawn": {
                "$ref": "#/$defs/anchor"
              }
            },
            "oneOf": [
              {
                "required": [
                  "area"
                ]
              },
              {
                "required": [
                  "spawn"
                ]
              }
            ],
            "x-hint": "a reach task needs exactly one of \"area\" or \"spawn\""
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "talk"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "id",
              "type",
              "objective",
              "npc",
              "lines"
            ],
            "propertyNames": {
              "enum": [
                "id",
                "type",
                "objective",
                "onComplete",
                "npc",
                "lines"
              ]
            },
            "properties": {
              "npc": {
                "$ref": "#/$defs/id"
              },
              "lines": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/line"
                }
              }
            }
          }
        }
      ]
    },
    "onComplete": {
      "type": "object",
      "properties": {
        "flags": {
          "$ref": "#/$defs/flagMap"
        },
        "scene": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "scene": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/command"
      }
    },
    "command": {
      "type": "object",
      "properties": {
        "cmd": {
          "enum": [
            "say",
            "move",
            "face",
            "wait",
            "fade",
            "camera",
            "music",
            "sound",
            "show",
            "hide",
            "warp",
            "flag"
          ]
        },
        "parallel": {
          "type": "boolean"
        }
      },
      "required": [
        "cmd"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "say"
              }
            },
            "required": [
              "cmd"
            ]
          },
          "then": {
            "required": [
              "cmd",
              "lines"
            ],
            "propertyNames": {
              "enum": [
                "cmd",
                "parallel",
                "lines"
              ]
            },
            "properties": {
              "lines": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/line"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "move"
              }
            },
            "required": [
              "cmd"
            ]
          },
          "then": {
            "required": [
              "cmd",
              "actor",
              "path"
            ],
            "propertyNames": {
              "enum": [
                "cmd",
                "parallel",
                "actor",
                "path"
              ]
            },
            "properties": {
              "actor": {
                "$ref": "#/$defs/id"
              },
              "path": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "#/$defs/tile"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "face"
              }
            },
            "required": [
              "cmd"
            ]
          },
          "then": {
            "required": [
              "cmd",
              "actor"
            ],
            "propertyNames": {
              "enum": [
                "cmd",
                "parallel",
                "actor",
                "dir",
                "toward"
              ]
            },
            "properties": {
              "actor": {
                "$ref": "#/$defs/id"
              },
              "dir": {
                "$ref": "#/$defs/direction"
              },
              "toward": {
                "$ref": "#/$defs/id"
              }
            },
            "oneOf": [
              {
                "required": [
                  "dir"
                ]
              },
              {
                "required": [
                  "toward"
                ]
              }
            ],
            "x-hint": "a face command needs exactly one of \"dir\" or \"toward\""
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "wait"
              }
            },
            "required": [
              "cmd"
            ]
          },
          "then": {
            "required": [
              "cmd",
              "ms"
            ],
            "propertyNames": {
              "enum": [
                "cmd",
                "parallel",
                "ms"
              ]
            },
            "properties": {
              "ms": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "fade"
              }
            },
            "required": [
              "cmd"
            ]
          },
          "then": {
            "required": [
              "cmd",
              "to"
            ],
            "propertyNames": {
              "enum": [
                "cmd",
                "parallel",
                "to",
                "ms"
              ]
            },
            "properties": {
              "to": {
                "enum": [
                  "out",
                  "in"
                ]
              },
              "ms": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "camera"
              }
            },
            "required": [
              "cmd"
            ]
          },
          "then": {
            "required": [
              "cmd",
              "to"
            ],
            "propertyNames": {
              "enum": [
                "cmd",
                "parallel",
                "to",
                "ms"
              ]
            },
            "properties": {
              "to": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/tile"
                  },
                  {
                    "$ref": "#/$defs/id"
                  }
                ],
                "x-hint": "must be a tile [x, y], an actor id or \"player\""
              },
              "ms": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "music"
              }
            },
            "required": [
              "cmd"
            ]
          },
          "then": {
            "required": [
              "cmd",
              "track"
            ],
            "propertyNames": {
              "enum": [
                "cmd",
                "parallel",
                "track"
              ]
            },
            "properties": {
              "track": {
                "oneOf": [
                  {
                    "$ref": "#/$defs/track"
                  },
                  {
                    "type": "null"
                  }
                ],
                "x-hint": "must be a track id (mus_…) or null to stop"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "sound"
              }
            },
            "required": [
              "cmd"
            ]
          },
          "then": {
            "required": [
              "cmd",
              "sfx"
            ],
            "propertyNames": {
              "enum": [
                "cmd",
                "parallel",
                "sfx"
              ]
            },
            "properties": {
              "sfx": {
                "$ref": "#/$defs/sfx"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "show"
              }
            },
            "required": [
              "cmd"
            ]
          },
          "then": {
            "required": [
              "cmd",
              "npc",
              "location",
              "tile",
              "facing"
            ],
            "propertyNames": {
              "enum": [
                "cmd",
                "parallel",
                "npc",
                "location",
                "tile",
                "facing"
              ]
            },
            "properties": {
              "npc": {
                "$ref": "#/$defs/id"
              },
              "location": {
                "$ref": "#/$defs/id"
              },
              "tile": {
                "$ref": "#/$defs/tile"
              },
              "facing": {
                "$ref": "#/$defs/direction"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "hide"
              }
            },
            "required": [
              "cmd"
            ]
          },
          "then": {
            "required": [
              "cmd",
              "npc"
            ],
            "propertyNames": {
              "enum": [
                "cmd",
                "parallel",
                "npc"
              ]
            },
            "properties": {
              "npc": {
                "$ref": "#/$defs/id"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "warp"
              }
            },
            "required": [
              "cmd"
            ]
          },
          "then": {
            "required": [
              "cmd",
              "location",
              "spawn"
            ],
            "propertyNames": {
              "enum": [
                "cmd",
                "parallel",
                "location",
                "spawn",
                "facing"
              ]
            },
            "properties": {
              "location": {
                "$ref": "#/$defs/id"
              },
              "spawn": {
                "$ref": "#/$defs/anchor"
              },
              "facing": {
                "$ref": "#/$defs/direction"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "cmd": {
                "const": "flag"
              }
            },
            "required": [
              "cmd"
            ]
          },
          "then": {
            "required": [
              "cmd",
              "set"
            ],
            "propertyNames": {
              "enum": [
                "cmd",
                "parallel",
                "set"
              ]
            },
            "properties": {
              "set": {
                "$ref": "#/$defs/flagMap"
              }
            }
          }
        }
      ]
    },
    "trigger": {
      "type": "object",
      "properties": {
        "on": {
          "enum": [
            "storyStart",
            "enterArea",
            "talk"
          ]
        },
        "once": {
          "type": "boolean"
        },
        "when": {
          "$ref": "#/$defs/condition"
        },
        "scene": {
          "$ref": "#/$defs/id"
        },
        "location": {
          "$ref": "#/$defs/id"
        },
        "area": {
          "$ref": "#/$defs/anchor"
        },
        "npc": {
          "$ref": "#/$defs/id"
        }
      },
      "required": [
        "on",
        "scene"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "on": {
                "const": "storyStart"
              }
            },
            "required": [
              "on"
            ]
          },
          "then": {
            "required": [
              "on",
              "scene"
            ],
            "propertyNames": {
              "enum": [
                "on",
                "when",
                "once",
                "scene"
              ]
            },
            "properties": {}
          }
        },
        {
          "if": {
            "properties": {
              "on": {
                "const": "enterArea"
              }
            },
            "required": [
              "on"
            ]
          },
          "then": {
            "required": [
